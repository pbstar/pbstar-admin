{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@Pcomponents": [
        "../components/index.ts"
      ],
      "@Pcomponents/*": [
        "../components/*"
      ],
      "@Passets/*": [
        "../assets/*"
      ]
    }
  },
  "include": [
    "appInit.ts",
    "useMicroApp.ts",
    "env.d.ts",
    "../components/**/*",
    "../components/**/*.vue",
    "../assets/**/*"
  ]
}